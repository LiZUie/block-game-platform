{
  "name": "@blockgame/cloud-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run build --prefix=../web-portal && node -e \"const fs=require('fs'); fs.cpSync('../web-portal/dist', 'dist', {recursive:true});\"",
    "start": "node dist/server.js",
    "test": "tsx --test src/test/api.test.ts"
  },
  "dependencies": {
    "@blockgame/shared": "file:../shared",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
